{
  "name": "dsh-mobile-direct",
  "version": "0.1.0",
  "description": "Scan-once mobile entry for DeepSeek Harness — a QR in the top-right of the web UI that pairs the DSH Mobile app (or opens a one-tap browser session) using a LAN address the phone can actually reach.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "cordis",
    "deepseek-harness",
    "mobile",
    "qr",
    "pairing",
    "relay",
    "lan"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hajimimaodie8/dsh-mobile-direct.git"
  },
  "author": "hajimimaodie8",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7",
    "dsh-relay": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "dsh-relay": {
      "optional": true
    }
  }
}
